---
import Layout from '../Layout.astro';
---

<Layout title="BLACKPINK - Concerts & Tours">

    <main>
        <section class="tour-section fade-in">
            <h1 class="page-title">World Tour</h1>
            <p class="page-subtitle">BLACKPINK In Your Area</p>
            <div class="tour-grid">
                <div class="tour-top">
                    <h3>36+</h3>
                    <p>Cities Visited</p>
                </div>
                <div class="tour-top">
                    <h3>1.8M+</h3>
                    <p>Fans Attended</p>
                </div>
                <div class="tour-top">
                    <h3>5</h3>
                    <p>Continents</p>
                </div>
            </div>
        </section>

        <section class="tour-section2 fade-in-right">
            <h2 class="section-title">Upcoming Events (2025-2026)</h2>
            <p class="section-subtitle">Get ready to see BLACKPINK live!</p>
            <div class="tour-list">
                <div class="tour-card">
                    <div class="tour-date">
                        <span class="month">DEC</span>
                        <span class="day">04-16</span>
                        <span class="year">2025</span>
                    </div>
                    <div class="tour-details">
                        <h3 class="tour-event">DEADLINE Tour Pop-Up Store: Osaka</h3>
                        <div class="tour-location">
                            <span>&#128205;</span>
                            <span>Osaka, Japan</span>
                        </div>
                        <div class="tour-venue">Daimaru Umeda</div>
                        <div class="tour-status confirmed">Confirmed</div>
                        <p class="tour-description">
                            Experience the exclusive "DEADLINE" world before the concert. Shop for limited-edition Osaka merchandise, view photo exhibitions and enjoy interactive zones designed for BLINKs.
                        </p>
                    </div>
                    <div class="tour-button">
                        <button class="tour-btn primary">Get Tickets</button>
                        <button class="tour-btn secondary">More Info</button>
                    </div>
                </div>

                <div class="tour-card">
                    <div class="tour-date">
                        <span class="month">DEC</span>
                        <span class="day">12-18</span>
                        <span class="year">2025</span>
                    </div>
                    <div class="tour-details">
                        <h3 class="tour-event">DEADLINE Tour Pop-Up Store: Kyoto</h3>
                        <div class="tour-location">
                            <span>&#128205;</span>
                            <span>Kyoto, Japan</span>
                        </div>
                        <div class="tour-venue">Mina Kyoto(Loft)</div>
                        <div class="tour-status confirmed">Confirmed</div>
                        <p class="tour-description">
                            Celebrate the holiday season with BLACKPINK in Kyoto. This special pop-up features holiday-themed items and a retrospective showcase of the group's best stage outfits.
                        </p>
                    </div>
                    <div class="tour-button">
                        <button class="tour-btn primary">Get Tickets</button>
                        <button class="tour-btn secondary">More Info</button>
                    </div>
                </div>

                <div class="tour-card">
                    <div class="tour-date">
                        <span class="month">JAN</span>
                        <span class="day">16-18</span>
                        <span class="year">2026</span>
                    </div>
                    <div class="tour-details">
                        <h3 class="tour-event">DEADLINE World Tour in Tokyo</h3>
                        <div class="tour-location">
                            <span>&#128205;</span>
                            <span>Tokyo, Japan</span>
                        </div>
                        <div class="tour-venue">Tokyo Dome</div>
                        <div class="tour-status confirmed">Confirmed</div>
                        <p class="tour-description">
                            BLACKPINK returns to the legendary Tokyo Dome for three unforgettable nights. Witness the spectacular stage production and powerful performances as they conquer Japan's most prestigious venue once again.
                        </p>
                    </div>
                    <div class="tour-button">
                        <button class="tour-btn primary">Get Tickets</button>
                        <button class="tour-btn secondary">More Info</button>
                    </div>
                </div>

                <div class="tour-card">
                    <div class="tour-date">
                        <span class="month">JAN</span>
                        <span class="day">24-26</span>
                        <span class="year">2026</span>
                    </div>
                    <div class="tour-details">
                        <h3 class="tour-event">DEADLINE World Tour: Grand Finale</h3>
                        <div class="tour-location">
                            <span>&#128205;</span>
                            <span>Hong Kong, China</span>
                        </div>
                        <div class="tour-venue">Kai Tak Stadium</div>
                        <div class="tour-status announced">Just Announced</div>
                        <p class="tour-description">
                            The epic conclusion of the world tour. Join the final celebration at the brand-new Kai Tak Stadium. Expect special encore performances and a tearful, historic send-off for this era.
                        </p>
                    </div>
                    <div class="tour-button">
                        <button class="tour-btn primary">Get Tickets</button>
                        <button class="tour-btn secondary">More Info</button>
                    </div>
                </div>

                <div class="tour-card">
                    <div class="tour-date">
                        <span class="month">AUG</span>
                        <span class="day">08</span>
                        <span class="year">2026</span>
                    </div>
                    <div class="tour-details">
                        <h3 class="tour-event">BLACKPINK 10TH Anniversary Special</h3>
                        <div class="tour-location">
                            <span>&#128205;</span>
                            <span>Seoul, South Korea</span>
                        </div>
                        <div class="tour-venue">To be announced...</div>
                        <div class="tour-status announced">Just Announced</div>
                        <p class="tour-description">
                            A decade of the BLACKPINK. A monumental event celebrating 10 years of music, history and the unbreakable bond with BLINKs. Stay tuned for venue details and ticketing information.
                        </p>
                    </div>
                    <div class="tour-button">
                        <button class="tour-btn primary">Pre-Sale Info</button>
                        <button class="tour-btn secondary">More Info</button>
                    </div>
                </div>
            </div>
        </section>

        <section class="tour-section3 fade-in-right">
            <h2 class="section-title">Tour History</h2>
            <p class="section-subtitle">A journey through BLACKPINK's legendary performances</p>
            
            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <h3>BORN PINK World Tour</h3>
                        <span class="timeline-year">2022-2023</span>
                        <p>
                            The most successful tour by a Korean girl group in history. Spanning 36 cities across 5 continents with 1.8 million fans in attendance. The tour broke numerous records and solidified BLACKPINK's status as global superstars.
                        </p>
                        <div class="timeline-bottom">
                            <span class="bottom">36 Cities</span>
                            <span class="bottom">66 Shows</span>
                            <span class="bottom">1.8M Fans</span>
                        </div>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <h3>BLACKPINK World Tour [In Your Area]</h3>
                        <span class="timeline-year">2018-2020</span>
                        <p>
                            Their first world tour visiting Asia, North America, Europe, and Oceania. This tour marked BLACKPINK's emergence as a global phenomenon, with sold-out shows across major cities worldwide.
                        </p>
                        <div class="timeline-bottom">
                            <span class="bottom">23 Cities</span>
                            <span class="bottom">32 Shows</span>
                            <span class="bottom">Sold Out</span>
                        </div>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <h3>Coachella 2019</h3>
                        <span class="timeline-year">2019</span>
                        <p>
                            Historic performance as the first K-pop girl group to perform at Coachella Valley Music and Arts Festival. This groundbreaking appearance introduced BLACKPINK to mainstream Western audiences and set the stage for K-pop's global expansion.
                        </p>
                        <div class="timeline-bottom">
                            <span class="bottom">Historic</span>
                            <span class="bottom">First K-pop Girl Group</span>
                            <span class="bottom">100K+ Attendance</span>
                        </div>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <h3>BLACKPINK Arena Tour</h3>
                        <span class="timeline-year">2018</span>
                        <p>
                            Japanese arena tour showcasing BLACKPINK's massive popularity in Japan. Playing  major venues across Japanese cities, this tour demonstrated their ability to fill large arenas just two years after debut.
                        </p>
                        <div class="timeline-bottom">
                            <span class="bottom">7 Cities</span>
                            <span class="bottom">12 Shows</span>
                            <span class="bottom">200K+ Fans</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="tour-section4 fade-in-up">
            <h2 class="section-title">Tour Highlights</h2>
            <p class="section-subtitle">Click to watch performance videos</p>
           <div class="gallery-grid">
                <div class="gallery-item" data-video="VLpUsmBafMQ">
                    <img src="/images/coachella.jpg" alt="Coachella Performance">
                    <div class="gallery-overlay">
                        <span class="play-icon">▶</span>
                        <span class="gallery-title">Coachella 2023</span>
                    </div>
                </div>
                <div class="gallery-item" data-video="EFqqJ5_txPs">
                    <img src="/images/born-pink.jpg" alt="Born Pink World Tour">
                    <div class="gallery-overlay">
                        <span class="play-icon">▶</span>
                        <span class="gallery-title">Born Pink Tour</span>
                    </div>
                </div>
                <div class="gallery-item" data-video="e7Vhw4J_pSk">
                    <img src="/images/stage.jpg" alt="BST Hyde Park">
                    <div class="gallery-overlay">
                        <span class="play-icon">▶</span>
                        <span class="gallery-title">BST Hyde Park</span>
                    </div>
                </div>
                <div class="gallery-item" data-video="W-9-keHNwV8">
                    <img src="/images/fans.jpg" alt="Behind the Scenes">
                    <div class="gallery-overlay">
                        <span class="play-icon">▶</span>
                        <span class="gallery-title">Behind the Scenes</span>
                    </div>
                </div>
                <div class="gallery-item" data-video="P169hsXjYQs">
                    <img src="/images/deadline.webp" alt="DEADLINE 2025">
                    <div class="gallery-overlay">
                        <span class="play-icon">▶</span>
                        <span class="gallery-title">DEADLINE 2025</span>
                    </div>
                </div>
                <div class="gallery-item" data-video="jubpICnlc-Q">
                    <img src="/images/arena.jpg" alt="Arena Tour">
                    <div class="gallery-overlay">
                        <span class="play-icon">▶</span>
                        <span class="gallery-title">Arena Tour</span>
                    </div>
                </div>
            </div>
        </section>

        <div id="videoModal" class="video-modal">
            <div class="video-content">
                <span class="video-close">&times;</span>
                <div class="video-container">
                    <iframe id="videoFrame" 
                            width="100%" 
                            height="100%" 
                            src="" 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                            allowfullscreen>
                    </iframe>
                </div>
            </div>
        </div>

        <section class="tour-section5 fade-in-up">
            <h2>Never Miss a Show</h2>
            <p>Subscribe to get notified about new tour dates and ticket sales</p>
            <div class="tour-form">
                <input type="email" placeholder="Enter your email address" class="tour-input">
                <button class="tour-btn">Subscribe</button>
            </div>
        </section>
    </main>

   
</Layout>